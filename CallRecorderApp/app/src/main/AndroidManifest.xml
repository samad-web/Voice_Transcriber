<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Platform enrollment + config sync (activation gate) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scan the activation QR (instance id + admin key) on the admin screen -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- In-app updates. This app is sideloaded, not on Play, so nothing else can
         replace it - without this a fix means physically collecting handsets.
         Android verifies the new APK is signed with the installed app's key, so
         neither permission can be used to swap in a different app. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: lets this app install ITS OWN updates without the system's
         "Update app?" dialog (update/UpdateSession.kt has the conditions). It
         covers self-updates only, never installing any other app. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Core capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Foreground service to survive backgrounding while recording (Android 14 granular type) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reading the OEM dialer's own call recordings (Samsung "Auto record calls", MIUI, …).
         Those files are BOTH-ends audio the system dialer captured from the modem, which a
         normal app can't do itself - so we ingest them instead. MANAGE_EXTERNAL_STORAGE is
         needed to read arbitrary OEM folders on API 30+; READ_MEDIA_AUDIO/READ_EXTERNAL_STORAGE
         covers the MediaStore route. (All-files access is Play-restricted; fine when sideloaded.) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Call detection / metadata (optional; request at runtime, degrade gracefully) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Needed so EXTRA_INCOMING_NUMBER is populated (the number becomes the recording name) -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Attendance (Build docs/33 §10). None of these adds any audio capture:
         presence is measured from call activity, never from a microphone. -->
    <!-- The shift service: a foreground service of type specialUse (see the property below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Re-arm the shift-start alarm after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The presence check, new leads and managers' messages show over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Shift start, reminders and presence-check deadlines on time; inexact fallback when refused. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The guided setup asks for the exemption: Samsung's sleeping-apps list otherwise
         kills the shift service mid-shift. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- network_lost / network_restored during a shift, and the "no internet" notice. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Finishing a heartbeat upload on a dozing phone (WorkManager declares it too). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Aura">

        <!-- The real launcher: gates the whole app behind the instance's app-lock
             password (if the CRM has set one) before MainActivity is reachable. -->
        <activity
            android:name=".ui.LockActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Admin-only device activation (hidden entry: long-press toolbar title) -->
        <activity
            android:name=".ui.AdminActivationActivity"
            android:exported="false" />

        <!-- Discovery tool: locates the OEM dialer's call-recording folder on this handset
             and proves we can read it (the prerequisite for ingesting both-ends audio). -->
        <activity
            android:name=".ui.RecordingsScannerActivity"
            android:exported="false" />

        <!-- Applies an already-downloaded, digest-verified update. No layout: it
             only exists to give the system's install confirmation a foreground
             window (a background component cannot launch one on Android 10+).
             singleTop because the PackageInstaller session reports its status
             back into this same activity via onNewIntent. -->
        <activity
            android:name=".update.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Aura.Invisible" />

        <!-- Full-screen QR scanner (Paytm-style viewfinder) for reading the activation QR -->
        <activity
            android:name=".ui.scanner.QrScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Aura" />


        <!-- The "eyes and ears": detects which call app is foreground and reads caller info.
             This is the clean-room analogue of Cube ACR's separate helper app.
             Kept IN this app (local dispatch) instead of a second signed APK. -->
        <service
            android:name=".service.CallAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- The "hands": owns the AudioRecord capture + encoding, runs as a foreground service. -->
        <service
            android:name=".service.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- FCM push receiver: wakes the app for instant logout/wipe/ping from
             the platform console instead of waiting for the ~1h config poll,
             and for phone alerts (new leads, tasks, managers' messages). -->
        <service
            android:name=".platform.AuraFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Unattended updates: the install outcome (explicit intent from our own
             PendingIntent) and MY_PACKAGE_REPLACED (sent by the system to the new
             build). Neither needs exporting - the system reaches unexported
             receivers. -->
        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ── Attendance (Build docs/33) ── -->

        <!-- The telecaller's Attendance screen (reached from MainActivity, behind the app lock). -->
        <activity
            android:name=".attendance.AttendanceActivity"
            android:exported="false" />

        <!-- The presence check. Shows over the lock screen from a full-screen-intent
             notification; its own task so answering it never surfaces the rest of the app. -->
        <activity
            android:name=".attendance.PresenceCheckActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="com.voicetranscriber.callrecorder.presence"
            android:turnScreenOn="true" />

        <!-- Phone alerts (platform 0150): new leads and managers' messages over the
             lock screen from a full-screen-intent notification, or one alert opened
             from the shade. Its own task, like the presence check, so answering it
             never surfaces the rest of the app. -->
        <activity
            android:name=".alerts.AlertActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity="com.voicetranscriber.callrecorder.alerts"
            android:turnScreenOn="true" />

        <!-- "Got it" on an alert notification. -->
        <receiver
            android:name=".alerts.AlertActionReceiver"
            android:exported="false" />

        <!-- Runs only inside a shift window. specialUse: no other foreground-service
             type describes "keep a workday's presence timers and reminders running". -->
        <service
            android:name=".attendance.ShiftService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Workplace attendance during the employee's scheduled shift only: runs the shift's presence-check, break and reminder timers and sends a heartbeat every 2 minutes, all shown in an ongoing notification. Records no audio and nothing outside the shift. The app is distributed by the employer (sideloaded), not through Google Play." />
        </service>

        <receiver
            android:name=".attendance.AttendanceAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".attendance.AttendanceActionReceiver"
            android:exported="false" />

        <!-- Exported only because BOOT_COMPLETED requires it; it acts on nothing but
             system broadcasts, and only re-arms the stored schedule. -->
        <receiver
            android:name=".attendance.AttendanceBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Phone-call state (native cellular calls) -->
        <receiver
            android:name=".service.PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Lets us hand recording files to other apps (share sheet) via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
