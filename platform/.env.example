# ── Database / cache / queue / storage (matches docker-compose.yml) ──────────
# Admin/owner connection (migrations). Host port 5433 — native Postgres owns 5432.
DATABASE_URL=postgresql://aura:aura_dev_password@localhost:5433/callintel
# Runtime connection — non-superuser role so RLS is enforced.
APP_DATABASE_URL=postgresql://aura_app:aura_app_password@localhost:5433/callintel
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://aura:aura_dev_password@localhost:5672
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=aura-recordings
S3_ACCESS_KEY_ID=aura_minio
S3_SECRET_ACCESS_KEY=aura_minio_password

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
# Dev-only admin auth for platform endpoints until OIDC lands
ADMIN_API_KEY=dev-admin-key
# Seals CRM credentials at rest with AES-256-GCM. Unset = plaintext storage and
# a warning at boot. Generate with: openssl rand -hex 32
# Losing this key makes every stored CRM credential unreadable — they have to be
# re-entered, so back it up wherever you keep JWT_SECRET.
CRM_SECRET_KEY=dev-crm-secret-key-not-for-production
JWT_SECRET=replace-with-a-long-random-secret
DEVICE_JWT_TTL_SECONDS=900

# ── ASR + analyze provider ───────────────────────────────────────────────────
# Pipeline precedence: ASR_STUB/ANALYZE_STUB > SARVAM > GEMINI.
#
# Sarvam is the primary provider for Indic call audio. Saaras v3 runs on the
# BATCH api — submit, poll, download — which is the only way to get acoustic
# speaker diarization and audio longer than 30s. The pipeline therefore parks
# the call in TRANSCRIBING with a job id and the ASR poller finishes it.
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_STT_MODEL=saaras:v3
# transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODE=transcribe
# BCP-47 (ta-IN, kn-IN, hi-IN…) or `unknown` to detect per call.
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_SPEAKERS=2
# sarvam-105b (₹4 in / ₹16 out per 1M) or sarvam-30b (₹2.5 / ₹10). Both are far
# below the ASR line on the invoice, so pick on quality, not price.
SARVAM_CHAT_MODEL=sarvam-105b
ASR_POLL_INTERVAL_MS=15000
ASR_JOB_TIMEOUT_MS=1800000
#
# Fallback, used only while SARVAM_API_KEY is unset. Gemini transcribes and
# diarizes in one call, then labels those segments during analyze.
# Do NOT set these to gemini-2.5-flash: retired for new users, answers 404.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_ASR_MODEL=gemini-3.5-flash
# Analyze is text-only and schema-constrained — gemini-3.5-flash-lite does it
# for a fraction of the cost. Switch ASR to flash-lite too only after checking
# it on real multi-lingual calls; audio is where quality actually differs.
# Always a PINNED id, never a `-latest` alias — an alias moves underneath a
# running deployment and fails calls without a deploy of ours.
GEMINI_ANALYZE_MODEL=gemini-3.5-flash
#
# Thinking tokens bill at the output rate and neither stage needs reasoning, so
# the pipeline asks for the least Gemini will do. Use the LEVEL, not a budget:
# Gemini 3 models reject `thinkingBudget: 0` with 400 INVALID_ARGUMENT.
# minimal | low | medium | high.
GEMINI_THINKING_LEVEL=minimal
#
# Ring-outs and misdials shorter than this are not transcribed at all. 0 = off.
MIN_TRANSCRIBE_SECONDS=5
#
# Dev-only: run pipeline stages without any provider (clearly-labeled stub output).
ASR_STUB=0
ANALYZE_STUB=0

# ── Model provider layer (analyze stage fallbacks; leave blank if unused) ────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Web app ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# Console sign-in (Supabase Auth). Project Settings → API in the Supabase
# dashboard. Leave both blank to run the console unauthenticated in local dev —
# /login then reports that auth is not configured and no route is gated, and
# /owner falls back to DEV_ORG_ID so the owner pages are still usable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Emails allowed into the operator console when they have no owner membership.
# Blank = any signed-in non-owner is the operator (the local-dev default).
PLATFORM_OPERATOR_EMAILS=

# ── Owner logins (API side) ───────────────────────────────────────────────────
# Provisioning a customer owner's sign-in calls Supabase's admin API, which
# needs the service_role key. Server-side only — it bypasses RLS, so it must
# never appear in a NEXT_PUBLIC_ variable. Blank = owners can be listed but not
# created.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Quiet hours for outbound messages ───────────────────────────────────────
# Local hours (in SCHEDULER_TIMEZONE) between which the booking outbox holds
# non-urgent messages instead of sending them. 21 and 9 mean "nothing goes out
# between 21:00 and 09:00". Held messages are re-queued for the moment the
# window ends; they do NOT consume a retry.
#
# LEAVE BOTH BLANK TO DISABLE. There is no default window on purpose —
# inventing one would silently change when an existing deployment's messages
# go out.
#
# reminder_call_1h and reminder_call_5m are ALWAYS exempt: deferring those
# delivers them after the call they are about.
QUIET_HOURS_START=
QUIET_HOURS_END=

# ── Razorpay payment links (Kailash gap Milestone 1) ────────────────────────
# Platform-level fallback used by an org with no payment_gateway_config row of
# its own. A payment link never marks anything paid by itself — only a
# signed webhook delivery to /v1/webhooks/razorpay does that.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Outbound WhatsApp via Wasi (Kailash gap Milestone 3) ────────────────────
# Off by default, same reasoning as EMAIL_SENDING_ENABLED: a fresh deployment
# should not be able to message a real customer until someone deliberately
# turns this on. Aura never talks to Meta directly — every send goes through
# Wasi's Hub API (C:\Users\mas20\Desktop\work\Wasi) using the credentials
# stored on that org's messaging_channels row (provider='wasi').
WHATSAPP_SENDING_ENABLED=false
WHATSAPP_SEND_DAILY_LIMIT=100

# ── Meta Lead Ads (Kailash gap Milestone 4) ─────────────────────────────────
# A Meta App with pages_show_list/pages_manage_ads/leads_retrieval permissions
# and (for production Pages) App Review approval — external setup, same class
# of blocker as the existing Google/Microsoft OAuth app registration gap.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=
