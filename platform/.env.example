# ── Database / cache / queue / storage (matches docker-compose.yml) ──────────
# Admin/owner connection (migrations). Host port 5433 — native Postgres owns 5432.
DATABASE_URL=postgresql://aura:aura_dev_password@localhost:5433/callintel
# Runtime connection — non-superuser role so RLS is enforced.
APP_DATABASE_URL=postgresql://aura_app:aura_app_password@localhost:5433/callintel
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://aura:aura_dev_password@localhost:5672

# ── Live console updates ──────────────────────────────────────────────────
# The console refreshes itself as data arrives, over a change-signal bus on the
# RABBITMQ_URL above (a fanout exchange, `aura.events`). Nothing extra to
# install, and nothing new to open on the firewall.
#
# Read by the API, the worker AND the web tier, so it is set once, here.
# Turning it off is a restart rather than a rebuild: the console goes back to
# updating on navigation, exactly as it behaved before this feature existed.
#
#   REALTIME_DISABLED=1  kill switch. Every process stops publishing and the
#                        consoles stop connecting. Reach for it if the broker is
#                        in trouble - nothing else in the product depends on it.
REALTIME_DISABLED=
# How long the API folds repeated changes to the same (org, topic) into one
# signal. Raise it if a bulk import causes visible churn; lower it, within
# reason, if updates feel laggy. Default 400ms.
REALTIME_COALESCE_MS=
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=aura-recordings
S3_ACCESS_KEY_ID=aura_minio
S3_SECRET_ACCESS_KEY=aura_minio_password

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
# Dev-only admin auth for platform endpoints until OIDC lands
ADMIN_API_KEY=dev-admin-key
# Seals CRM credentials at rest with AES-256-GCM. Unset = plaintext storage and
# a warning at boot. Generate with: openssl rand -hex 32
# Losing this key makes every stored CRM credential unreadable — they have to be
# re-entered, so back it up wherever you keep JWT_SECRET.
CRM_SECRET_KEY=dev-crm-secret-key-not-for-production
JWT_SECRET=replace-with-a-long-random-secret
DEVICE_JWT_TTL_SECONDS=900

# ── ASR + analyze provider ───────────────────────────────────────────────────
# Pipeline precedence: ASR_STUB/ANALYZE_STUB > SARVAM > GEMINI.
#
# Sarvam is the primary provider for Indic call audio. Saaras v3 runs on the
# BATCH api — submit, poll, download — which is the only way to get acoustic
# speaker diarization and audio longer than 30s. The pipeline therefore parks
# the call in TRANSCRIBING with a job id and the ASR poller finishes it.
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_STT_MODEL=saaras:v3
# transcribe | translate | verbatim | translit | codemix
SARVAM_STT_MODE=transcribe
# BCP-47 (ta-IN, kn-IN, hi-IN…) or `unknown` to detect per call.
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_SPEAKERS=2
# sarvam-105b (₹4 in / ₹16 out per 1M) or sarvam-30b (₹2.5 / ₹10). Both are far
# below the ASR line on the invoice, so pick on quality, not price.
SARVAM_CHAT_MODEL=sarvam-105b
ASR_POLL_INTERVAL_MS=15000
ASR_JOB_TIMEOUT_MS=1800000
#
# Fallback, used only while SARVAM_API_KEY is unset. Gemini transcribes and
# diarizes in one call, then labels those segments during analyze.
# Do NOT set these to gemini-2.5-flash: retired for new users, answers 404.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_ASR_MODEL=gemini-3.5-flash
# Analyze is text-only and schema-constrained — gemini-3.5-flash-lite does it
# for a fraction of the cost. Switch ASR to flash-lite too only after checking
# it on real multi-lingual calls; audio is where quality actually differs.
# Always a PINNED id, never a `-latest` alias — an alias moves underneath a
# running deployment and fails calls without a deploy of ours.
GEMINI_ANALYZE_MODEL=gemini-3.5-flash
#
# Thinking tokens bill at the output rate and neither stage needs reasoning, so
# the pipeline asks for the least Gemini will do. Use the LEVEL, not a budget:
# Gemini 3 models reject `thinkingBudget: 0` with 400 INVALID_ARGUMENT.
# minimal | low | medium | high.
GEMINI_THINKING_LEVEL=minimal
#
# Ring-outs and misdials shorter than this are not transcribed at all. 0 = off.
MIN_TRANSCRIBE_SECONDS=5
#
# Dev-only: run pipeline stages without any provider (clearly-labeled stub output).
ASR_STUB=0
ANALYZE_STUB=0

# ── Model provider layer (analyze stage fallbacks; leave blank if unused) ────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Web app ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# Console sign-in (Supabase Auth). Leave both blank to run the console
# unauthenticated in local dev — /login then reports that auth is not configured
# and no route is gated, and /owner falls back to DEV_ORG_ID so the owner pages
# are still usable. That is the normal local setup; `docker compose up` here
# starts a plain Postgres with no auth server in front of it.
#
# To develop against real sign-in, point these at the self-hosted stack
# (supabase/selfhost — SUPABASE_PUBLIC_URL and ANON_KEY from its .env.selfhost)
# rather than at a Supabase Cloud project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Emails allowed into the operator console when they have no owner membership.
# Blank = any signed-in non-owner is the operator (the local-dev default).
PLATFORM_OPERATOR_EMAILS=

# The ROOT operator - the one account that may appoint and remove other
# superadmins from the console (migration 0089, /operators). Everything else in
# the operator console stays open to every operator equally.
#
# Kept HERE rather than as a platform_operators row on purpose: the root is what
# authorises changes to that table, so a root that lived inside it could be
# deleted by anything that reached the table and replaced with someone else's
# address. The worst case for a compromised console is then a table full of
# unwanted superadmins the real root can still clear out - not a platform with a
# new owner.
#
# Unset is safe, and is simply the pre-0089 behaviour: nobody can appoint
# anybody, and PLATFORM_OPERATOR_EMAILS remains the entire allowlist. Read by
# the web tier (the console) and by the API, which uses it to refuse adding or
# deleting the root as a row.
PLATFORM_ROOT_OPERATOR_EMAIL=

# ── Owner logins (API side) ───────────────────────────────────────────────────
# Provisioning a customer owner's sign-in calls Supabase's admin API, which
# needs the service_role key. Server-side only — it bypasses RLS, so it must
# never appear in a NEXT_PUBLIC_ variable. Blank = owners can be listed but not
# created.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Quiet hours for outbound messages ───────────────────────────────────────
# Local hours (in SCHEDULER_TIMEZONE) between which the booking outbox holds
# non-urgent messages instead of sending them. 21 and 9 mean "nothing goes out
# between 21:00 and 09:00". Held messages are re-queued for the moment the
# window ends; they do NOT consume a retry.
#
# LEAVE BOTH BLANK TO DISABLE. There is no default window on purpose —
# inventing one would silently change when an existing deployment's messages
# go out.
#
# reminder_call_1h and reminder_call_5m are ALWAYS exempt: deferring those
# delivers them after the call they are about.
QUIET_HOURS_START=
QUIET_HOURS_END=

# ── Razorpay payment links (Kailash gap Milestone 1) ────────────────────────
# Platform-level fallback used by an org with no payment_gateway_config row of
# its own. A payment link never marks anything paid by itself — only a
# signed webhook delivery to /v1/webhooks/razorpay does that.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Outbound WhatsApp ────────────────────────────────────────────────────────
# Off by default, same reasoning as EMAIL_SENDING_ENABLED: a fresh deployment
# should not be able to message a real customer until someone deliberately
# turns this on. One switch covers every transport below.
WHATSAPP_SENDING_ENABLED=false
WHATSAPP_SEND_DAILY_LIMIT=100

# ── WhatsApp: the two kinds of account ───────────────────────────────────────
#
# These are not two vendors of one thing. They reach different kinds of
# WhatsApp account and the rules differ, which is why they are configured
# separately and why the console asks which one you are connecting first.
# The authoritative table is packages/shared/src/messaging-providers.ts.
#
#   BUSINESS (a WABA) — provider 'waba' or 'wasi'
#     A verified business number, through Meta's Cloud API directly or resold
#     by Wasi. Approved templates, Meta's 24-hour reply window, Meta approval
#     required. Credentials live per org on messaging_channels, entered in the
#     console; nothing deployment-wide is needed beyond the Embedded Signup
#     ids below.
#
#   PERSONAL — provider 'evolution'
#     An ordinary WhatsApp account, linked as a device the way WhatsApp Web
#     links one (github.com/EvolutionAPI/evolution-go, which speaks the same
#     multi-device protocol through whatsmeow). No approval, no templates, no
#     session window. UNOFFICIAL: Meta does not sanction it and the account can
#     be rate-limited or banned with no appeal. Use it to answer people who
#     wrote to you first.
#
# EVOLUTION_ADMIN_API_KEY is what lets a tenant link their own number from the
# console: the API creates one instance per org with a token it generates and
# stores encrypted. Unset, the console says the deployment cannot offer this —
# distinct from "you have not connected one". A deployment with a single global
# Evolution key can set both variables to the same value.
#
# The webhook handed to Evolution is built from APP_DOMAIN / INTAKE_PUBLIC_URL;
# with neither set, pairing refuses rather than linking a number that can never
# receive anything.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_ADMIN_API_KEY=

# ── WhatsApp lead qualification (migration 0080) ────────────────────────────
# Reads inbound WhatsApp threads from numbers matching no contact and proposes
# a lead for a HUMAN to approve. It never writes a contact, lead or deal by
# itself - approval is a route that requires a signed-in user, and the database
# CHECK refuses a decided row with no reviewer.
#
# There is no global on/off flag here on purpose: the switch is per tenant and
# lives in the operator console at Instances -> <instance> -> "WhatsApp lead
# qualification" (it rides PATCH /v1/org/policy, so the change is audited like
# every other policy edit). Default off. Qualification sends a tenant's own
# customer conversations to an LLM provider, which is a decision each tenant
# makes rather than one a deployment makes for all of them.
#
# Retention for the verdicts is per tenant too - `qualification_retention_days`,
# default 90 - and the reaper deletes decided verdicts past it. Pending ones are
# never reaped; a verdict still waiting on a human is an enquiry nobody has
# answered yet.
#
# With no GEMINI_API_KEY the sweep still runs and degrades to a keyword
# heuristic (English/Hinglish only), flagged as provider='heuristic' in the
# queue so a reviewer knows a model did not read it. QUALIFY_STUB=1 forces that
# path in tests.
QUALIFY_INTERVAL_MS=900000
# Ceiling on spend per org per tick, not on throughput - the next tick takes the
# next batch, so a backlog drains over hours instead of arriving as one bill.
QUALIFY_MAX_PER_TICK=25
# How stale a thread may be and still be worth a verdict. Speed-to-lead is the
# point; a verdict on a four-month-old enquiry is archaeology.
QUALIFY_LOOKBACK_DAYS=30

# ── Meta Lead Ads (Kailash gap Milestone 4) ─────────────────────────────────
# A Meta App with pages_show_list/pages_manage_ads/leads_retrieval permissions
# and (for production Pages) App Review approval — external setup, same class
# of blocker as the existing Google/Microsoft OAuth app registration gap.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=

# ── Platform sign-in apps and Stripe (doc 28 §16 item 3) ─────────────────────
# Read by the Integrations store to say "Not available" honestly: an app whose
# variables are unset is the operator's to set up, not the customer's to fix.
# Google/Microsoft are only the platform's FALLBACK - an organisation can bring
# its own sign-in app (migration 0120), which needs none of these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Stripe is held back from the store until payment links work end to end.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Lead intake engine (migration 0078) ─────────────────────────────────────
# The public origin a tenant's WEBSITE posts its form to. The API answers on
# `api:4000` inside the compose network and on https://<APP_DOMAIN>/v1 from the
# outside, and only the deployment knows which - so the console builds the
# endpoint URL it shows from this. Leave unset and it falls back to
# https://$APP_DOMAIN, then to API_URL for local development. Getting it wrong
# shows a tenant a URL that 404s from the internet, which is the most
# confusing failure this feature can have.
INTAKE_PUBLIC_URL=

# LinkedIn Lead Gen Forms. Needs an APPROVED LinkedIn Marketing Developer
# Platform app with the r_marketing_leadgen_automation scope - external setup,
# same class of blocker as the Google/Microsoft OAuth registrations above.
# With these unset the connector reports "not configured", the console says so
# instead of offering a button that fails, and the worker's sweep does not
# start. Nothing else on the intake page depends on them.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
# Pinned rather than "latest": LinkedIn versions its REST API by date header
# and has moved the lead-response payload's shape between versions, so an
# upgrade should be somebody's decision.
LINKEDIN_API_VERSION=202401
# How far back a first sweep asks, and the cap on one pass. Overlapping windows
# are free - the intake claim is idempotent on the response id.
LINKEDIN_LOOKBACK_HOURS=48
LINKEDIN_MAX_LEADS=200
LINKEDIN_SYNC_INTERVAL_MS=600000
# ── WhatsApp Embedded Signup via Wasi (migration 0104) ──────────────────────
# The client connects their own Facebook Business account and WhatsApp number
# from inside their console, instead of an operator pasting a number for them.
#
# These two are META'S PUBLIC IDS FOR WASI'S APP, not secrets: the browser has
# to send both to Facebook to open the signup window at all, so they are served
# to the page. The app SECRET is not here and must not be — Wasi holds it, and
# Wasi is the only party that redeems the authorization code. Aura never sees a
# Meta access token.
#
# Read them off Wasi's own `GET /api/onboarding/config`, which reports the same
# two values it hands its own frontend. Unset means the connect button renders
# disabled with a message saying so, rather than opening a window that fails.
WASI_META_APP_ID=
WASI_META_CONFIG_ID=

# Where Wasi accepts a completed signup over the HUB API (an API key), as
# opposed to `/api/onboarding/whatsapp/connect`, which is mounted behind a
# browser session (`requireClientAuth`) and cannot be called server-to-server.
#
# OUTSTANDING DEPENDENCY: that Hub-API route does not exist on Wasi yet. Its
# `requireApiKey` middleware already resolves a key to the same `req.clientId`
# the onboarding router expects, so exposing one is a small change there — but
# until it lands, completing a signup returns a 409 naming exactly this, the
# captured waba_id/phone_number_id are stored against the channel, and an
# operator finishes the connection on Wasi's admin page. Override if the final
# path differs; no rebuild needed.
WASI_ONBOARDING_PATH=/api/v1/onboarding/whatsapp/connect

# ── Firebase Cloud Messaging (device wakeup / instant logout+wipe) ──────────
# Path to the Firebase Admin SDK service account JSON (downloaded from
# Firebase Console → Project Settings → Service Accounts → Generate New
# Private Key). Unset = FCM push disabled; logout/wipe still propagate via
# the ~1h ConfigRefreshWorker poll on the handset.
#
# This PATH form is for local dev only. In Docker use the _B64 form instead
# (see .env.production.example): the containers have no bind mount for a key
# file, so a path set there resolves to nothing inside the container and push
# stays silently disabled. The service account must belong to the same Firebase
# project as CallRecorderApp/app/google-services.json (auratel-9ddbd), or every
# send fails with a sender mismatch.
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── CRM drift checker (apps/worker/src/pipeline/crm-reconcile.ts) ───────────
# Compares recently active leads against the contact and deal projected from
# them, and logs every disagreement to crm_reconciliation_log - including a lead
# that never became a contact (doc 23, F3). OFF unless set to exactly "true".
CRM_RECONCILE_ENABLED=false
# Also compare stage/status. Leave off until lead->deal stage sync is verified
# in this environment, or every historic divergence floods the log.
CRM_RECONCILE_INCLUDE_STAGE=false
# Only leads active in the last N days are checked.
CRM_RECONCILE_WINDOW_DAYS=3
# Rows per page. Every page in the window is walked; this only sizes each query.
CRM_RECONCILE_BATCH=500

# ── Account menu, storage meter (Build docs/27) ─────────────────────────────
# How often the worker measures each workspace's stored call recordings
# (apps/worker/src/pipeline/storage-usage.ts). The console reads the snapshot,
# never a live sum. Default 1 hour. The nightly database estimate runs once a
# day after 02:00 IST regardless of this.
STORAGE_USAGE_INTERVAL_MS=3600000
# Who a tenant contacts to change their plan - an email address or an https
# URL. Shown on Plan & usage as "contact your account manager"; blank shows the
# sentence without a link. Read by the web server at request time.
NEXT_PUBLIC_SUPPORT_CONTACT=
