# Caddy terminates TLS for the whole stack and gets certificates from Let's
# Encrypt on first request. Both domains must already resolve to this box.

{
	email {$ACME_EMAIL}
	# Uncomment while testing to avoid burning Let's Encrypt rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ── Console + API on one domain ──────────────────────────────────────────────
# The Android app and the browser both hit https://{$APP_DOMAIN}; /v1/* is the
# API and everything else is the Next.js console.
{$APP_DOMAIN} {
	encode zstd gzip

	handle /v1/* {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/access-app.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

# ── Self-hosted Supabase on its own domain ───────────────────────────────────
# The console signs in against {$SUPABASE_DOMAIN}/auth/v1, and the browser has
# to reach the same origin the token was issued for - so this is a real public
# vhost, not an internal hop.
#
# WHY A SUBDOMAIN RATHER THAN A PATH ON {$APP_DOMAIN}: that host is already
# fully carved up (/v1 to the API, /admin to the console, / to the marketing
# site). Adding /auth/v1, /rest/v1, /storage/v1 and the Studio root to it means
# four more prefixes competing with a catch-all, in two separate edge configs.
# A subdomain has none of that, and it needs one DNS A record.
#
# The upstream is the Envoy gateway in the `aura-supabase` compose project,
# reachable here because docker-compose.aura.yml joins it to this network under
# the alias `supabase-gateway`. It publishes nothing to the host.
#
# Studio (the dashboard, at /) is behind the gateway's basic auth -
# DASHBOARD_USERNAME / DASHBOARD_PASSWORD in .env.selfhost. That is the ONLY
# thing between the internet and a SQL console over every tenant's data;
# supabase/selfhost/bin/verify-selfhost.sh asserts it answers 401.
{$SUPABASE_DOMAIN} {
	encode zstd gzip

	reverse_proxy supabase-gateway:8000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /data/access-supabase.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

# ── Object storage on its own domain ─────────────────────────────────────────
# Devices upload recording parts straight to MinIO using presigned URLs the API
# signs against S3_PUBLIC_ENDPOINT. SigV4 covers the Host header, so this domain
# must match S3_PUBLIC_ENDPOINT exactly and Caddy must NOT rewrite the Host —
# it doesn't by default, which is why there is no header_up here.
{$STORAGE_DOMAIN} {
	reverse_proxy minio:9000 {
		# Recording parts are multi-MB; don't buffer them in the proxy.
		flush_interval -1
	}

	log {
		output file /data/access-storage.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
