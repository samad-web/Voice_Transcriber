# Environment for the self-hosted Supabase stack (the `aura-supabase` project).
#
#   cd platform/supabase/selfhost
#   cp .env.selfhost.example .env.selfhost
#   node bin/generate-keys.js >> .env.selfhost   # fills in every secret below
#   chmod 600 .env.selfhost
#
# This is a SECOND credentials file, separate from platform/.env.production.
# Both are gitignored. The two share exactly one value - the Postgres password -
# and it appears here as POSTGRES_PASSWORD and there inside DATABASE_URL.
#
# Pass it explicitly on every command; there is no implicit .env pickup:
#   docker compose --env-file .env.selfhost \
#     -f upstream/docker-compose.yml -f docker-compose.aura.yml <cmd>

# ══════════════════════════════════════════════════════════════════════════════
# SECRETS - every one of these is replaced by `node bin/generate-keys.js`
# ══════════════════════════════════════════════════════════════════════════════

# The `postgres` superuser password, and also the password for the supabase
# service roles (authenticator, supabase_auth_admin, supabase_storage_admin,
# supabase_functions_admin, pgbouncer) - upstream's volumes/db/roles.sql sets
# them all from this one value at database init.
#
# It is baked into the data directory at first start. Changing it later needs
# ALTER USER inside the database as well as an edit here, or the stack comes up
# with half its services unable to authenticate. See upstream/utils/db-passwd.sh.
#
# Must be URL-safe, because it is embedded in DATABASE_URL in .env.production.
# generate-keys.js emits alphanumeric only for exactly this reason.
POSTGRES_PASSWORD=

# Signs every JWT the auth server issues, and is the shared secret every other
# Supabase service verifies against. At least 32 characters.
#
# THIS IS NOT THE SAME SECRET AS THE CLOUD PROJECT'S. Cutting over therefore
# invalidates every existing console session and signs everyone out exactly
# once. Passwords are unaffected - bcrypt hashes migrate across (see
# bin/export-from-cloud.sh), so nobody needs a reset.
JWT_SECRET=

# HS256 JWTs signed with JWT_SECRET, carrying {"role":"anon"} and
# {"role":"service_role"}. generate-keys.js derives them from JWT_SECRET - they
# are not independent values, and regenerating JWT_SECRET invalidates both.
#
# ANON_KEY is public by design: it ships in the console's browser bundle as
# NEXT_PUBLIC_SUPABASE_ANON_KEY and grants nothing on its own.
# SERVICE_ROLE_KEY bypasses RLS entirely. It belongs in this file and in
# .env.production as SUPABASE_SERVICE_ROLE_KEY, and nowhere else - never in a
# NEXT_PUBLIC_ variable, never in the web image.
ANON_KEY=
SERVICE_ROLE_KEY=

# Basic-auth credentials the gateway demands before it will serve Supabase
# Studio. Studio has no login of its own; this is the ONLY thing between the
# open internet and a full SQL console on every tenant's data. Treat it as a
# root password.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

# Phoenix/Elixir signing base for realtime and supavisor. Exactly 64 chars.
SECRET_KEY_BASE=
# Supavisor's credential vault key. Exactly 32 chars.
VAULT_ENC_KEY=
# postgres-meta's crypto key. Exactly 32 chars.
PG_META_CRYPTO_KEY=
# Realtime's per-tenant DB encryption key. Exactly 32 chars.
REALTIME_DB_ENC_KEY=

# Credentials for Storage's S3-compatible protocol endpoint. Unused by Aura -
# recordings go to the platform's own MinIO - but the container wants them set.
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# The new opaque publishable/secret key format. Left blank: Aura uses the legacy
# ANON_KEY / SERVICE_ROLE_KEY JWTs above, which is what @supabase/ssr in the
# console and SupabaseAdminService in the API both send.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_KEYS=
JWT_JWKS=

# ══════════════════════════════════════════════════════════════════════════════
# URLS - set these to your domains before first start
# ══════════════════════════════════════════════════════════════════════════════

# Where this stack is reachable from a browser. Needs its own DNS A record and
# its own vhost (docker/Caddyfile or docker/nginx-aura.conf both have one).
#
# It must be a PUBLIC https origin, not http://api-gw:8000: the console's
# session cookies and the JWT issuer are both tied to it, and the browser has to
# reach the same origin the token was minted for.
SUPABASE_PUBLIC_URL=https://supabase.example.com

# The auth server's own external URL, and the `iss` claim on every token it
# issues. Changing it after users exist invalidates their sessions.
API_EXTERNAL_URL=https://supabase.example.com/auth/v1

# Where GoTrue sends people after email links. The console lives under /admin on
# the app domain (NEXT_PUBLIC_BASE_PATH in docker-compose.prod.yml).
SITE_URL=https://app.example.com/admin
# The console's Google sign-in callback (app/auth/callback). GoTrue only sends a
# sign-in code to an address on this list; anything else falls back to SITE_URL.
ADDITIONAL_REDIRECT_URLS=https://app.example.com/admin/auth/callback

# "Continue with Google" + invite links (migration 0137). A Google Cloud OAuth
# client of type "Web application" whose Authorized redirect URI is
# ${API_EXTERNAL_URL}/callback, i.e. https://supabase.example.com/auth/v1/callback.
# The secret stays on this box, like SERVICE_ROLE_KEY. Leave GOOGLE_ENABLED=false
# and the console shows no Google button at all.
#
# DISABLE_SIGNUP=true below still holds with Google on: an unknown Google
# account is refused by GoTrue, and an invitee gets through because the invite
# page creates their auth user first (SupabaseAdminService.ensureUser).
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# ══════════════════════════════════════════════════════════════════════════════
# AUTH POLICY - the defaults here are deliberately more closed than upstream's
# ══════════════════════════════════════════════════════════════════════════════

# MUST STAY true. The console has no signup form, but the endpoint is open
# otherwise, and the anon key needed to call it is published in the browser
# bundle. Upstream ships this as `false`; leaving it there lets a stranger
# self-register. Owner logins are provisioned by an operator through
# POST /v1/owners/:id/login, which uses the service-role key and is unaffected.
DISABLE_SIGNUP=true

ENABLE_EMAIL_SIGNUP=true
# The API creates owner accounts with email_confirm: true already
# (SupabaseAdminService.createUser), so blanket autoconfirm is not needed.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Access-token lifetime in seconds. The refresh token in the session cookie
# renews it transparently; this only bounds how long a stolen access token is
# useful. 3600 matches Supabase Cloud's default.
JWT_EXPIRY=3600

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# ── SMTP ─────────────────────────────────────────────────────────────────────
#
# NOTHING IN AURA SENDS AUTH EMAIL TODAY. Operators provision owner logins with
# a generated password read out to the customer, so no confirmation or recovery
# mail is ever triggered. These are placeholders that keep the container happy.
#
# The consequence to know: with no working SMTP, the "Forgot password?" flow
# does not work. Password resets go through the console
# (POST /v1/owners/:id/login/reset) instead. Point these at a real relay if you
# want self-service recovery.
SMTP_ADMIN_EMAIL=ops@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Aura

# ══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════════════════════════

# Internal to this compose project - the service name upstream uses. Aura
# connects from the other project as `supabase-db` (see docker-compose.aura.yml).
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── Loopback ports, published for operator access only ───────────────────────
#
# Both are bound to 127.0.0.1 by docker-compose.aura.yml. Reach them over an SSH
# tunnel; nothing should ever open these to the internet.
#
# CHECK `ss -ltnp` BEFORE FIRST START. If the VPS already runs a native
# Postgres, 5432 is taken and the container will fail to bind.
POOLER_SESSION_HOST_PORT=15432
POOLER_PROXY_PORT_TRANSACTION=6543

# The gateway, which the host nginx / Caddy proxies to. 18084 continues the
# repo's loopback numbering (18080-18083 are in docker-compose.nginx.yml).
API_GW_HTTP_PORT=18084

POOLER_TENANT_ID=aura
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# ══════════════════════════════════════════════════════════════════════════════
# SERVICES AURA DOES NOT USE
# ══════════════════════════════════════════════════════════════════════════════

# PostgREST. `graphql_public` and NOT `public` - see the long note on the `rest`
# service in docker-compose.aura.yml. Adding `public` here exposes every
# tenant's data to anyone holding the published anon key.
PGRST_DB_SCHEMAS=graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# Supabase Storage. Aura's recordings are in its own MinIO (S3_ENDPOINT in
# .env.production), uploaded by phones against presigned URLs the API signs.
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=stub
IMGPROXY_AUTO_WEBP=true

# Edge functions. None are deployed.
FUNCTIONS_VERIFY_JWT=false

# Studio cosmetics.
STUDIO_DEFAULT_ORGANIZATION=Aura
STUDIO_DEFAULT_PROJECT="Aura Platform"
# Studio's optional SQL-assistant integration. Leave blank - it would send
# schema context to OpenAI.
OPENAI_API_KEY=
