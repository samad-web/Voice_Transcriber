# @aura/marketing — public configuration.
#
# No secrets. This app has no Supabase client and no auth, and it reads NOTHING
# from platform/.env.production or apps/web/.env.local, both of which point at
# live production. Keep it that way - docker-compose.prod.yml deliberately does
# not give this container `env_file: .env.production`, because it is the one
# service answering unauthenticated traffic from the open internet.
#
# The NEXT_PUBLIC_ values below are inlined into the HTML at build time. Two
# things are read at request time instead and are documented where they are
# used: FUNNEL_* / GOOGLE_* for the booking funnel, and APP_API_ORIGIN below.

# The public origin the site is served from. Used for canonicals, OpenGraph
# URLs, robots.txt and the sitemap. Apex or www — NOT aura.sirahagents.com,
# which stays the console + API host (moving it means re-enrolling every handset
# in the field).
NEXT_PUBLIC_SITE_URL=https://www.sirahagents.com

# The WhatsApp number every primary CTA deep-links to, in international format
# with no +, spaces or dashes. e.g. 919876543210
#
# REQUIRED BEFORE LAUNCH. While it is unset, every WhatsApp CTA renders as a
# visibly unconfigured placeholder instead of a dead link — see lib/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Where the /app install page reads GET /v1/app/latest from, to show which build
# it is offering. Optional: defaults to the public API origin, and production
# sets it to http://api:4000 so the call stays on the compose network. The
# endpoint is unauthenticated - this is not a credential.
APP_API_ORIGIN=
