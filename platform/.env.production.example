# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production          # it holds every credential the stack has
#
# This file is read TWICE: `env_file:` injects it into the containers, and
# `--env-file .env.production` supplies the ${VAR} substitutions in the compose
# file. Always pass --env-file.
#
# Generate secrets with:  openssl rand -base64 36 | tr -d '/+=' | head -c 40

# ── Domains (must already point at this server) ──────────────────────────────
APP_DOMAIN=app.example.com
STORAGE_DOMAIN=storage.example.com
ACME_EMAIL=ops@example.com
# The self-hosted Supabase stack's own vhost. Needs its own DNS A record, and
# its own certificate if you terminate TLS with certbot rather than Caddy.
#
# It must EQUAL the host in NEXT_PUBLIC_SUPABASE_URL below and SUPABASE_PUBLIC_URL
# in supabase/selfhost/.env.selfhost. The JWT issuer and the console's session
# cookies are both tied to this origin, so a mismatch presents as "sign-in does
# nothing" rather than as a proxy error.
SUPABASE_DOMAIN=supabase.example.com
# The PUBLIC marketing site — the apex, not the console host. Baked into the
# image at build time as NEXT_PUBLIC_SITE_URL, so it drives canonical URLs, Open
# Graph tags and sitemap.xml. Changing it needs `up -d --build`, not a restart:
# a restart leaves the old origin compiled into every page.
SITE_DOMAIN=example.com

# ══════════════════════════════════════════════════════════════════════════════
# MARKETING SITE (the `marketing` container only)
#
# These three are the ONLY secrets that container gets. It is the one service
# serving unauthenticated public traffic, so docker-compose.prod.yml gives it an
# explicit allowlist instead of `env_file: .env.production` — it never sees
# ADMIN_API_KEY, the Supabase service-role key, the S3 secret or the Evolution
# key. Keep it that way when adding anything here.
# ══════════════════════════════════════════════════════════════════════════════

# The funnel's database login. NOT the app's DATABASE_URL, and not interchangeable
# with it: this is the `aura_marketing` role, which holds USAGE on the `marketing`
# schema and nothing else — no access to `public`, NOBYPASSRLS, no DELETE. That
# narrowness is the entire security argument for letting a public web server hold
# a database credential at all, so pointing this at a wider role silently removes
# the protection with no visible symptom.
#
# Created and its password rotated by scripts/apply-marketing-schema.sh, which
# prints the password once - put it here.
#
# Self-hosted, so the username is the plain role name. (On Supabase Cloud this
# had to be `aura_marketing.<project-ref>`, which was a pooler convention, not a
# Postgres one - drop the suffix or the login fails.)
FUNNEL_DATABASE_URL=postgresql://aura_marketing:PASSWORD@supabase-db:5432/postgres

# Signs the two-hour funnel session cookie carrying step 1 of the form into
# step 2. Rotating it invalidates in-flight forms — a visitor mid-enquiry loses
# their answers and starts again. Rotate between campaigns, not during one.
#   openssl rand -base64 36 | tr -d '/+=' | head -c 40
FUNNEL_COOKIE_SECRET=

# Salts the one-way hash of visitor IPs used for rate limiting. The raw IP is
# never stored anywhere. Rotating this resets every rate-limit window, which is
# a nuisance rather than a breach.
FUNNEL_HASH_SALT=

# Optional. Absent, the WhatsApp call-to-action is not rendered at all rather
# than rendering a broken wa.me link. Digits with country code, no +.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Google Calendar ──────────────────────────────────────────────────────────
#
# What this does: when a visitor books a slot, the booking is mirrored into a
# real Google Calendar as an event. The database still owns availability — the
# team defines free slots in the console and the atomic claim is what stops two
# people taking the same time — but the event, and the lead's invite, come from
# here.
#
# WITHOUT ALL THREE OF THE FIRST VARIABLES, BOOKING STILL WORKS AND NOTHING
# REACHES A CALENDAR. That is the failure worth understanding before launch: the
# visitor gets a valid confirmation, the slot is genuinely reserved, and no event
# appears anywhere. It is silent by design (an unconfigured calendar is not an
# error), so the check is a query, not a log:
#
#   SELECT id, starts_at, booked_name, calendar_error
#     FROM marketing.booking_slots
#    WHERE status = 'booked' AND calendar_event_id IS NULL;
#
# Setup: Google Cloud project → enable the Calendar API → create a service
# account → share the target calendar with the service account's email, giving
# it "Make changes to events".
GOOGLE_CALENDAR_ID=sales@example.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=aura-calendar@project-id.iam.gserviceaccount.com
# The PEM from the service-account JSON, on one line with literal \n sequences —
# that is how it survives a .env file, and the scheduler unescapes them.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional, and it decides whether the LEAD is invited or only your team sees the
# event. A bare service account cannot add attendees; to invite the enquirer it
# must act as a real Workspace mailbox, which needs domain-wide delegation
# (Admin console → Security → API controls → Domain-wide delegation, scope
# https://www.googleapis.com/auth/calendar). Set this to that mailbox.
GOOGLE_CALENDAR_IMPERSONATE_SUBJECT=

# Booking window defaults, all optional. Times are local to SCHEDULER_TIMEZONE.
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_SLOT_MINUTES=30
SCHEDULER_DAY_START=10:00
SCHEDULER_DAY_END=18:00
SCHEDULER_WEEKDAYS=1,2,3,4,5
SCHEDULER_MIN_NOTICE_MINUTES=120
SCHEDULER_MAX_SLOTS=12

# ── Database: self-hosted Supabase ───────────────────────────────────────────
#
# Postgres runs on this box, in the separate `aura-supabase` compose project
# (supabase/selfhost/). `supabase-db` is the network alias that project puts on
# its database — see supabase/selfhost/docker-compose.aura.yml for why it is not
# called `db`, which is a real footgun and not a naming preference.
#
# Both passwords are POSTGRES_PASSWORD / APP_DB_PASSWORD from
# supabase/selfhost/.env.selfhost. generate-keys.js emits alphanumeric-only
# values precisely so nothing here needs percent-encoding.
#
# Owner connection: migrations, role bootstrap, and the pre-tenant admin flows.
# On self-hosted this really is the superuser, unlike Supabase Cloud's
# restricted `postgres` — which is why 0042 can finally install pg_trgm.
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD_VALUE@supabase-db:5432/postgres
#
# Runtime connection: the NON-superuser role created by 0001 and given its real
# password by `node packages/db/bootstrap-role.js`. RLS only binds because this
# role is neither the table owner nor BYPASSRLS — never point this at postgres.
APP_DATABASE_URL=postgresql://aura_app:APP_DB_PASSWORD_VALUE@supabase-db:5432/postgres
#
# Read by bootstrap-role.js only. Must be >=24 chars, alphanumeric plus _-.~!@#%^*+=
# and must match the password embedded in APP_DATABASE_URL above.
APP_DB_PASSWORD=replace-with-a-long-random-password
#
# ── DB_SSL=0 IS REQUIRED, AND OMITTING IT BREAKS THE MARKETING SITE ──────────
#
# packages/db/ssl.js decides TLS from the hostname: loopback and the names
# `postgres`/`db` get plaintext, everything else gets TLS. `supabase-db` is
# deliberately not in that set, so without this line the API, worker and
# marketing site all try to negotiate TLS against a Postgres on a private
# compose network that is not serving it.
#
# The marketing container makes this non-optional rather than merely advisable:
# docker-compose.prod.yml pins it to `DB_SSL: ${DB_SSL:-1}`, so with this unset
# it defaults to ON for that container specifically, and the funnel cannot
# reach its database while everything else looks fine.
#
# Traffic never leaves the box — it is a private Docker network between
# containers on one host. To encrypt it anyway, enable TLS on the Postgres
# container first, then set DB_SSL=1 and point DB_SSL_CA at its CA.
DB_SSL=0
# DB_SSL_CA=/etc/ssl/supabase/selfhost-ca.crt

# ── Queue / cache (local to the box, never published) ────────────────────────
RABBITMQ_USER=aura
RABBITMQ_PASSWORD=replace-with-a-long-random-password
RABBITMQ_URL=amqp://aura:replace-with-a-long-random-password@rabbitmq:5672
REDIS_URL=redis://redis:6379

# ── Live console updates ──────────────────────────────────────────────────
# The console refreshes itself as data arrives, carried on the RabbitMQ above
# (fanout exchange `aura.events`). No extra service, no extra port: the broker
# is already local to this box and never published.
#
# Read by api, worker AND web, all of which load this file - so set it once.
# Leave it blank in normal operation.
#
#   REALTIME_DISABLED=1  kill switch, applied on `./deploy.sh` (a restart, not
#                        a rebuild). Consoles fall back to updating on
#                        navigation, which is how they behaved before this
#                        existed - so it is a safe thing to reach for.
#
# NOTHING ELSE NEEDS CHANGING TO DEPLOY THIS. The browser's stream is served by
# the web container at /admin/events and carries `X-Accel-Buffering: no`, which
# is what stops the host nginx (docker/nginx-aura.conf) buffering it into
# uselessness; Caddy detects text/event-stream on its own. Neither vhost needs
# a new location block.
REALTIME_DISABLED=

# ── Object storage (MinIO on this box, fronted by STORAGE_DOMAIN) ────────────
S3_ACCESS_KEY_ID=aura-prod-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-password
S3_BUCKET=aura-recordings
S3_REGION=ap-south-1
# Internal: what the API and worker use to read/write objects. Container DNS,
# no TLS, no proxy hop.
S3_ENDPOINT=http://minio:9000
# Public: ONLY used to presign the upload URLs handed to phones. Must equal
# https://$STORAGE_DOMAIN — SigV4 signs the Host, so a mismatch means every
# device upload fails with SignatureDoesNotMatch.
S3_PUBLIC_ENDPOINT=https://storage.example.com

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
# Browser origin allowed by CORS — the console is served from the same domain.
WEB_ORIGIN=https://app.example.com
# Platform-operator key for /v1/admin/* and the enrollment QR flow. Rotate it
# and every provisioning script has to be updated: treat it as a root password.
ADMIN_API_KEY=replace-with-a-long-random-key
# Signs device JWTs. Rotating it forces every phone to re-enroll.
JWT_SECRET=replace-with-a-long-random-secret
# Seals CRM credentials at rest (AES-256-GCM). REQUIRED: unset or still holding
# the placeholder below, `assertRequiredEnv()` THROWS under NODE_ENV=production
# (which docker/node.Dockerfile bakes into the image) and the API never starts —
# permanent crash loop, taking the console and device ingest with it. Without
# the assertion it would instead store customer CRM API keys in plaintext.
#   openssl rand -hex 32
# Back it up with JWT_SECRET: lose it and every connected CRM must be
# re-authenticated by hand. ADMIN_API_KEY, JWT_SECRET and APP_DATABASE_URL are
# fatal on the same terms; all four are reported in one error, so one pass over
# this file is enough.
CRM_SECRET_KEY=replace-with-openssl-rand-hex-32
DEVICE_JWT_TTL_SECONDS=900

# ── ASR + analyze provider ───────────────────────────────────────────────────
# Precedence in the pipeline: ASR_STUB/ANALYZE_STUB > SARVAM > GEMINI.
#
# Sarvam is the primary provider for Indic call audio. Saaras v3 runs on the
# BATCH api — submit, poll, download — which is the only way to get acoustic
# speaker diarization and audio longer than 30s.
SARVAM_API_KEY=replace-with-your-sarvam-key
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE=unknown
SARVAM_STT_SPEAKERS=2
# sarvam-105b (₹4 in / ₹16 out per 1M) or sarvam-30b (₹2.5 / ₹10).
SARVAM_CHAT_MODEL=sarvam-105b
ASR_POLL_INTERVAL_MS=15000
ASR_JOB_TIMEOUT_MS=1800000
#
# Fallback, used only while SARVAM_API_KEY is unset.
# Do NOT set these to gemini-2.5-flash: retired for new users, answers 404.
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_ASR_MODEL=gemini-3.5-flash
# Analyze is text-only and schema-constrained — gemini-3.5-flash-lite does it
# for a fraction of the cost. Switch ASR to flash-lite too only after checking
# it on real multi-lingual calls; audio is where quality actually differs.
# Always a PINNED id, never a `-latest` alias: an alias moves underneath a
# running deployment. `gemini-flash-lite-latest` became gemini-3.5-flash-lite
# mid-morning and every analyze call started failing with no deploy of ours.
GEMINI_ANALYZE_MODEL=gemini-3.5-flash

# ── Cost controls ────────────────────────────────────────────────────────────
# Thinking tokens bill at the output rate and neither stage needs reasoning, so
# the pipeline asks for the least Gemini will do. Use the LEVEL, not a budget:
# Gemini 3 models reject `thinkingBudget: 0` with 400 INVALID_ARGUMENT.
# minimal | low | medium | high.
GEMINI_THINKING_LEVEL=minimal
# Ring-outs and misdials shorter than this are not transcribed at all. 0 = off.
MIN_TRANSCRIBE_SECONDS=5

# Stubs must be OFF in production — they write clearly-fake transcripts.
ASR_STUB=0
ANALYZE_STUB=0

# ── Web console ──────────────────────────────────────────────────────────────
# Baked into the client bundle at image build time (see docker/web.Dockerfile).
NEXT_PUBLIC_API_URL=https://app.example.com

# ── Console sign-in: self-hosted Supabase Auth ───────────────────────────────
# Both values come from supabase/selfhost/.env.selfhost — the URL is
# SUPABASE_PUBLIC_URL, the key is ANON_KEY — and both are baked into the browser
# bundle at IMAGE BUILD TIME (docker/web.Dockerfile).
#
# ⚠️  CHANGING EITHER NEEDS `./deploy.sh web` (a rebuild), NOT A RESTART.
# This is the single most common way a Supabase cutover appears to succeed and
# then fails at the first sign-in: every container is healthy, the API is fine,
# and the console is still holding the OLD project's URL and key compiled into
# its JavaScript.
#
# The anon key is designed to be public — it identifies the project to the auth
# server and grants nothing on its own. Never put the service_role key here.
#
# With either value blank the console runs unauthenticated: /login says auth is
# not configured and the middleware gate is inert. Set both in production.
#
# The self-hosted equivalents of the old dashboard checklist are all in
# .env.selfhost, already set to the safe values:
#   DISABLE_SIGNUP=true          (the console has no signup form; the endpoint
#                                 is open otherwise, and the anon key is public)
#   SITE_URL=https://app.example.com/admin
#   ENABLE_ANONYMOUS_USERS=false
# Operator and owner accounts are created through the console (instance page →
# Create owner login), which calls the API's service-role key below.
#
# PRIVATE BY DEFAULT: the internal gateway, not a public hostname. Every auth
# call the console makes runs server-side (server actions, middleware, route
# handlers - lib/supabase/client.ts, the browser client, is imported nowhere),
# so the web container reaches GoTrue over the compose network and the Supabase
# stack never has to face the internet. docker/nginx-aura.conf keeps its name
# dark. Only "Continue with Google" needs a public GoTrue (the browser follows
# its /authorize and /callback redirects) - publish those two paths if it is
# ever turned on.
NEXT_PUBLIC_SUPABASE_URL=http://supabase-gateway:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-ANON_KEY-from-.env.selfhost
# Server components reach the API over the compose network instead.
API_URL=http://api:4000
#
# "Continue with Google" only. The public origin a BROWSER uses for GoTrue's
# /auth/v1/authorize - needed because NEXT_PUBLIC_SUPABASE_URL above is the
# internal gateway on the private self-hosted stack. nginx forwards just that
# path and /auth/v1/callback from the app domain (supabase/selfhost/README.md,
# "Google sign-in on a private stack"). Blank = no Google button. Runtime
# variable: `up -d web`, no rebuild.
SUPABASE_AUTH_PUBLIC_URL=

# ── Owner logins (API side) ──────────────────────────────────────────────────
# Creating a customer owner's sign-in from the instance page needs Supabase's
# admin API, which the anon key cannot reach. The service_role key bypasses RLS
# entirely, so it lives ONLY here — never in a NEXT_PUBLIC_ variable, and never
# in the web image. It is SERVICE_ROLE_KEY in supabase/selfhost/.env.selfhost.
#
# Leave blank and the console still lists owners, but cannot create them (a
# yellow banner on the instance page says so).
#
# THE INTERNAL URL, not the public one. SupabaseAdminService talks to the
# gateway server-to-server over the compose network, so there is no reason to
# leave the box, resolve public DNS and terminate TLS to reach a container two
# hops away. `supabase-gateway` is the alias supabase/selfhost puts on Envoy.
#
# This is also why it is set explicitly rather than left to fall back to
# NEXT_PUBLIC_SUPABASE_URL: the fallback works, it is just the slow path.
SUPABASE_URL=http://supabase-gateway:8000
SUPABASE_SERVICE_ROLE_KEY=replace-with-SERVICE_ROLE_KEY-from-.env.selfhost

# ── Invite emails (migration 0137, API side) ─────────────────────────────────
# Team → Add someone → Invite link always SHOWS the link to the owner. It is
# emailed only when all four required values below are set AND the owner ticks
# "Email the link to them" for that one invite - the box is never pre-ticked,
# and with these blank the option does not appear at all.
#
# The platform's own mailbox, not a tenant's: an invite goes out before the
# invitee belongs to anything. STARTTLS on 587 by default; port 465 means
# implicit TLS (or set PLATFORM_SMTP_SECURE=true). AUTH LOGIN is always used,
# so user and password are required.
#
# Google sign-in itself is configured in supabase/selfhost/.env.selfhost
# (GOOGLE_ENABLED / GOOGLE_CLIENT_ID / GOOGLE_SECRET), not here.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_SECURE=
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
PLATFORM_MAIL_FROM=
PLATFORM_MAIL_FROM_NAME=Aura

# REQUIRED in production. Comma-separated emails allowed into the OPERATOR
# console (/dashboard, /instances, /admin). The parser trims and lower-cases.
#
# BLANK = NOBODY. isOperator() fails closed: with an empty list every account,
# including yours, gets the "No console access" card. It used to mean "any
# signed-in non-owner is an operator" — that was the hole, because the anon key
# ships in the browser bundle and Supabase enables signup by default, so a
# stranger could self-sign-up into every tenant's data.
#
# A signed-in user with an owner membership always goes to /owner and is
# unaffected. Being listed here WINS over holding a membership, so provisioning
# yourself an owner login on a test tenant cannot lock you out of the console.
#
# Read by the `web` service at runtime — changing it needs `up -d`, not a
# rebuild. Blank is announced in the web logs at startup.
PLATFORM_OPERATOR_EMAILS=ops@example.com
#
# The console's tenant-scoped pages (dashboard, calls, agents, search, usage,
# team, api-keys, crm) still resolve their org from this variable rather than
# from the signed-in session — /instances is the only multi-tenant view. On a
# fresh production database the seeded dev org does NOT exist, so leaving the
# default here makes those pages render empty. Set it to the org id of the
# customer you actually operate.
# The POST /v1/admin/tenants response in §4 gives you both ids.
DEV_ORG_ID=00000000-0000-0000-0000-000000000000
DEV_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# ── WhatsApp: Evolution GO ────────────────────────────────────────────────────
#
# Read by apps/worker to send funnel follow-ups (rejections today, reminders
# next). Unset, the worker logs each message and sends nothing — safe, and
# visible in the log rather than silent.
#
# This is Evolution GO (github.com/EvolutionAPI/evolution-go), NOT the
# TypeScript Evolution API. Different endpoint: POST /send/text, with the
# instance selected by the key rather than named in the URL. There is no
# EVOLUTION_INSTANCE variable, because the API has no such parameter.
#
# Confirm an instance is live before relying on it:
#   curl -H "apikey: $EVOLUTION_API_KEY" $EVOLUTION_BASE_URL/instance/status
#   → {"data":{"Connected":true,"LoggedIn":true,"Name":"…"},"message":"success"}
#
# The account can be rate-limited or banned by WhatsApp for behaviour that looks
# like bulk messaging. Reply to people who contacted you first; do not campaign.
EVOLUTION_BASE_URL=https://chat.example.com
EVOLUTION_API_KEY=
#
# ── PER-TENANT personal WhatsApp (migration 0123) ─────────────────────────────
#
# The two variables above are the PLATFORM's own single account, used by the
# worker for funnel nudges. EVOLUTION_ADMIN_API_KEY is different and is what
# lets each TENANT link a WhatsApp number of their own from the console
# (Messaging setup → "Your own WhatsApp number").
#
# With it set, the API calls POST /instance/create to give each org its own
# instance, with a per-instance token Aura generates and stores encrypted on
# that org's messaging_channels row (provider='evolution'). Without it, the
# console says the deployment cannot offer personal numbers — which is a
# different message from "you have not connected one", and deliberately so.
#
# WHY A SEPARATE KEY: EVOLUTION_API_KEY selects ONE instance server-side, so it
# can send but cannot create. The admin key is deployment-wide, creates and
# deletes instances, and is never written to a tenant row or returned to a
# browser. If your Evolution deployment uses one global key for both, set both
# variables to it — the code falls back to EVOLUTION_API_KEY when the admin key
# is unset, so a single-key deployment still works.
#
# The webhook URL handed to Evolution is built from APP_DOMAIN (or
# INTAKE_PUBLIC_URL). Get it wrong and numbers link successfully and receive
# nothing, so pairing refuses outright when neither is set.
EVOLUTION_ADMIN_API_KEY=

# ── Funnel follow-up reminders (worker) ──────────────────────────────────────
#
# One WhatsApp nudge to an enquirer who went quiet without booking. This is the
# ONLY message the platform sends that nobody provoked — a rejection follows an
# operator pressing a button, a confirmation follows a form submission, but this
# one goes to people who did nothing. So it is off unless this says exactly
# "true", and there is no default that turns it on.
#
# Read apps/worker/src/pipeline/funnel-reminders.ts before enabling it. The
# short version: reminders are only sent to enquiries INSIDE a window, never
# merely older than a threshold. Without the upper bound, switching this on
# would message every open enquiry ever received, all at once, which is both a
# bad look and the pattern that gets an unofficial WhatsApp account banned.
#
# The message itself is edited in the console at /leads → WhatsApp, not here.
FUNNEL_REMINDERS_ENABLED=false
# Send no earlier than this many days after the enquiry.
FUNNEL_REMINDER_AFTER_DAYS=3
# ...and never at all once it is older than this. MUST exceed AFTER_DAYS, or the
# window is empty and the sweep refuses to start rather than running silently.
FUNNEL_REMINDER_MAX_AGE_DAYS=14
# Cap per sweep. A ceiling on the damage a wrong predicate can do.
FUNNEL_REMINDER_BATCH=25

# ── Meta (Facebook) Pixel ────────────────────────────────────────────────────
#
# Absent, no pixel loads at all and the Lead conversion is a no-op. Keep it
# UNSET everywhere except production: a PageView fired from a developer machine
# or a preview build lands in the same dataset as a real visitor's and corrupts
# the conversion numbers the ad account optimises against.
#
# Baked in at build time, so changing it needs `up -d --build`, not a restart.
#
# TWO THINGS TO SETTLE BEFORE THIS GOES LIVE, both flagged in
# components/meta-pixel.tsx:
#   1. The privacy policy has been rewritten to disclose the pixel (§3 and §4 of
#      app/privacy/page.tsx). It is still gated behind lib/legal.ts, so the site
#      would be tracking visitors while telling them nothing until that ships.
#   2. An advertising pixel is not "strictly necessary", so the DPDP Act and the
#      GDPR normally want consent BEFORE it loads. It currently loads on every
#      page view without asking.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Tag Manager container id, GTM-XXXXXXX. Same rules as the pixel above:
# baked in at build time, fires on load with no consent prompt, and unset means
# no container loads at all. Whatever tags you add inside GTM inherit that — the
# container is the loophole through which a tag nobody reviewed here can start
# collecting data, so treat the GTM workspace as part of the privacy surface.
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity project id (the short code from the Clarity setup snippet,
# e.g. xzq5ehje0t). Same rules again: baked in at build time, fires on load
# with no consent prompt, unset means no session recording loads at all.
# Clarity records page interactions and masked input as session replays and
# heatmaps — update the /security disclosure if you change what it captures.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Quiet hours for outbound messages ───────────────────────────────────────
# Local hours (in SCHEDULER_TIMEZONE) between which the booking outbox holds
# non-urgent messages instead of sending them. 21 and 9 mean "nothing goes out
# between 21:00 and 09:00". Held messages are re-queued for the moment the
# window ends; they do NOT consume a retry.
#
# LEAVE BOTH BLANK TO DISABLE. There is no default window on purpose —
# inventing one would silently change when an existing deployment's messages
# go out.
#
# reminder_call_1h and reminder_call_5m are ALWAYS exempt: deferring those
# delivers them after the call they are about.
QUIET_HOURS_START=
QUIET_HOURS_END=

# ── Razorpay payment links (Kailash gap Milestone 1) ────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Outbound WhatsApp via Wasi (Kailash gap Milestone 3) ────────────────────
# Set to true only once real Wasi credentials are configured on at least one
# org's messaging_channels row — see .env.example for the full reasoning.
WHATSAPP_SENDING_ENABLED=false
WHATSAPP_SEND_DAILY_LIMIT=100

# ── Meta Lead Ads (Kailash gap Milestone 4) ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_OAUTH_REDIRECT_URI=

# ── Platform sign-in apps, LinkedIn and Stripe (doc 28 §16 item 3) ───────────
# The Integrations store reads these to say "Not available" honestly - see
# .env.example. Google/Microsoft are the platform's fallback app only; an
# organisation can bring its own (migration 0120).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── WhatsApp Embedded Signup via Wasi (migration 0093) ──────────────────────
# Meta's PUBLIC app + login-config ids for Wasi's app - served to the browser,
# never secrets. The app secret stays on Wasi, which is the only party that
# redeems the signup code. See .env.example for the full note, including the
# outstanding Hub-API onboarding route this depends on.
WASI_META_APP_ID=
WASI_META_CONFIG_ID=
WASI_ONBOARDING_PATH=/api/v1/onboarding/whatsapp/connect

# ── Firebase Cloud Messaging (device wakeup / instant logout+wipe) ──────────
# Base64 of the Firebase Admin SDK service-account JSON (Firebase Console →
# Project Settings → Service Accounts → Generate New Private Key), for the SAME
# project as CallRecorderApp/app/google-services.json - auratel-9ddbd. A key
# from a different project initialises cleanly and then fails every send with a
# sender mismatch.
#
#   base64 -w0 auratel-firebase-adminsdk-XXXXX.json      # Linux
#   base64 -i  auratel-firebase-adminsdk-XXXXX.json      # macOS
#
# Base64, not a path: the api container has no volume mount, so a
# FIREBASE_SERVICE_ACCOUNT_PATH set here points at a file that does not exist
# inside it. Not raw JSON either - the private key's newlines do not survive
# compose's env parsing. Base64 is the only form that works unattended.
#
# Unset = push disabled. Nothing breaks and nothing warns at the console: the
# handsets keep recording and uploading, remote logout/wipe/ping just fall back
# to the ~1h ConfigRefreshWorker poll. Confirm which state you are in with
#   docker compose ... logs api | grep -i "FCM push"
# -> "FCM push enabled (project auratel-9ddbd)" or the "No Firebase credential"
# warning. This is a secret: treat it like JWT_SECRET, never commit the value.
FIREBASE_SERVICE_ACCOUNT_B64=

# ── CRM drift checker (apps/worker/src/pipeline/crm-reconcile.ts) ───────────
# Compares recently active leads against the contact and deal projected from
# them, and logs every disagreement to crm_reconciliation_log - including a lead
# that never became a contact (doc 23, F3). OFF unless set to exactly "true".
CRM_RECONCILE_ENABLED=false
# Also compare stage/status. Leave off until lead->deal stage sync is verified
# in this environment, or every historic divergence floods the log.
CRM_RECONCILE_INCLUDE_STAGE=false
# Only leads active in the last N days are checked.
CRM_RECONCILE_WINDOW_DAYS=3
# Rows per page. Every page in the window is walked; this only sizes each query.
CRM_RECONCILE_BATCH=500

# ── Account menu, storage meter (Build docs/27) ─────────────────────────────
# How often the worker measures each workspace's stored call recordings
# (apps/worker/src/pipeline/storage-usage.ts). The console reads the snapshot,
# never a live sum. Default 1 hour. The nightly database estimate runs once a
# day after 02:00 IST regardless of this.
STORAGE_USAGE_INTERVAL_MS=3600000
# Who a tenant contacts to change their plan - an email address or an https
# URL. Shown on Plan & usage as "contact your account manager"; blank shows the
# sentence without a link. Read by the web server at request time.
NEXT_PUBLIC_SUPPORT_CONTACT=
